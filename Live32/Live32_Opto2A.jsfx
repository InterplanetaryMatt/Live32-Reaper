desc:Live32 Opto 2A Compressor
// Slow optical leveler for Live32 inserts.
// Teaching model with two-stage release and gentle valve-style curvature.
options:no_meter


in_pin:Main L
in_pin:Main R
in_pin:Key L
in_pin:Key R
in_pin:Pre EQ L
in_pin:Pre EQ R
in_pin:Post EQ L
in_pin:Post EQ R
out_pin:Main L
out_pin:Main R
out_pin:Key L
out_pin:Key R
out_pin:Pre EQ L
out_pin:Pre EQ R
out_pin:Post EQ L
out_pin:Post EQ R


slider1:35<0,100,1>Peak Reduction
slider2:0<0,40,0.1>Gain (dB)
slider3:0<0,1,1{COMPRESS,LIMIT}>Mode
slider4:0<-40,0,0.1>-Gain Reduction (dB)

@init
function live32_tanh(x) local(z) (
  x >= 10 ? 1 :
  x <= -10 ? -1 : (
    z=exp(2*x);
    (z-1)/(z+1);
  );
);
gr_db=0; meter_gr=0; slow_gr=0;
drive=1.08; sat_norm=live32_tanh(drive);

@slider
pr=slider1/100;
threshold=-4-pr*38;
ratio=slider3>=0.5 ? 10 : 3.2;
out_gain=10^(slider2/20);
attack=exp(-1/(0.010*srate));
fastrel=exp(-1/(0.060*srate));
slowrel=exp(-1/(1.8*srate));

@block
slider4=meter_gr; sliderchange(slider4); meter_gr=0;

@sample
l=spl0; r=spl1;
// Gentle optical/valve-style input rounding.
l=live32_tanh(l*drive)/sat_norm; r=live32_tanh(r*drive)/sat_norm;
level=20*log(max(max(abs(l),abs(r)),0.000000001))/log(10);
over=max(0,level-threshold);
target=-(over-over/ratio);
// Fast acquisition, program-dependent two-stage release.
target<gr_db ? (
  gr_db=attack*gr_db+(1-attack)*target;
  slow_gr=min(slow_gr,gr_db);
) : (
  fast_target=max(target,slow_gr*0.35);
  gr_db=fastrel*gr_db+(1-fastrel)*fast_target;
  slow_gr=slowrel*slow_gr;
  abs(slow_gr)<0.001 ? slow_gr=0;
);
g=10^(gr_db/20)*out_gain;
spl0=l*g; spl1=r*g;
meter_gr=min(meter_gr,gr_db);
