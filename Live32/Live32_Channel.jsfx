desc:Live32 Channel Strip
// Live32 v1.1.8 - teaching-oriented channel strip for REAPER
// Not affiliated with Midas. Designed to emulate live-console workflow, not proprietary DSP.

in_pin:Main L
in_pin:Main R
in_pin:Key L
in_pin:Key R
out_pin:Main L
out_pin:Main R
out_pin:Key L passthrough
out_pin:Key R passthrough
out_pin:Pre EQ L
out_pin:Pre EQ R
out_pin:Post EQ L
out_pin:Post EQ R

slider1:0<-18,18,0.1>Trim (dB)
slider2:0<0,1,1{Normal,Invert}>Phase
slider3:1<0,1,1{Off,On}>HPF
slider4:80<20,400,1:log!>HPF Frequency (Hz)

slider5:0<0,1,1{Off,On}>Gate
slider6:-45<-80,0,0.5>Gate Threshold (dB)
slider7:50<0,80,1>Gate Range (dB)
slider8:5<0.1,100,0.1:log!>Gate Attack (ms)
slider9:80<0,500,1>Gate Hold (ms)
slider10:180<5,2000,1:log!>Gate Release (ms)

slider11:1<0,1,1{Off,On}>EQ
slider12:100<20,400,1:log!>Low Frequency (Hz)
slider13:0<-15,15,0.1>Low Gain (dB)
slider14:0.8<0.3,10,0.1:log!>Low Q
slider15:500<80,2500,1:log!>Low Mid Frequency (Hz)
slider16:0<-15,15,0.1>Low Mid Gain (dB)
slider17:1.2<0.3,10,0.1:log!>Low Mid Q
slider18:2500<300,10000,1:log!>High Mid Frequency (Hz)
slider19:0<-15,15,0.1>High Mid Gain (dB)
slider20:1.2<0.3,10,0.1:log!>High Mid Q
slider21:8000<1000,20000,1:log!>High Frequency (Hz)
slider22:0<-15,15,0.1>High Gain (dB)
slider23:0.8<0.3,10,0.1:log!>High Q

slider24:0<0,1,1{Off,On}>Compressor
slider25:-18<-60,0,0.5>Comp Threshold (dB)
slider26:4<1,20,0.1>Comp Ratio
slider27:10<0.1,200,0.1:log!>Comp Attack (ms)
slider28:120<5,2000,1:log!>Comp Release (ms)
slider29:0<-12,18,0.1>Comp Makeup (dB)

// EQ modes and Dynamics Page 2 parameters.
slider30:2<0,2,1{LCUT,LSHV,PEQ}>Low EQ Mode
slider31:1<0,1,1{VEQ,PEQ}>Low Mid EQ Mode
slider32:1<0,1,1{VEQ,PEQ}>High Mid EQ Mode
slider33:0<0,2,1{PEQ,HSHV,HCUT}>High EQ Mode
slider34:0<0,5,1>Comp Knee
slider35:0<0,1,1{Off,On}>Comp Key Filter
slider36:120<20,20000,1:log!>Comp Key Filter Frequency (Hz)
slider37:0<0,1,1{Self,External 3/4}>Comp Key Source

// Output EQ extension. Buses and Main LR use these two additional parametric bands.
slider38:1000<100,8000,1:log!>Mid 1 Frequency (Hz)
slider39:0<-15,15,0.1>Mid 1 Gain (dB)
slider40:1.2<0.3,10,0.1:log!>Mid 1 Q
slider41:3500<300,16000,1:log!>Mid 2 Frequency (Hz)
slider42:0<-15,15,0.1>Mid 2 Gain (dB)
slider43:1.2<0.3,10,0.1:log!>Mid 2 Q
slider44:1<0,1,1{VEQ,PEQ}>Mid 1 EQ Mode
slider45:1<0,1,1{VEQ,PEQ}>Mid 2 EQ Mode
slider46:0<0,1,1{4 Band,6 Band}>EQ Topology

// Hidden activity telemetry read by the Live32 surface. These do not alter DSP.
slider47:0<0,30,0.01>-Comp GR Activity (dB)
slider48:0<0,1,0.001>-Gate Closed Activity

@init
pi = 3.141592653589793;
gate_gain = 1;
comp_gain = 1;
gate_env = 0;
comp_env = 0;
gate_hold_count = 0;
gate_meter = 0;
comp_meter = 0;

function db2lin(db) ( 10^(db/20); );
function lin2db(x) ( 20*log(max(x,0.000000000001))/log(10); );

function calc_peak(freq, q, gain_db, c)
local(A,w,alpha,cw,a0)
(
  A = 10^(gain_db/40);
  w = 2*pi*min(freq,srate*0.45)/srate;
  alpha = sin(w)/(2*max(q,0.05));
  cw = cos(w);
  a0 = 1 + alpha/A;
  c[0] = (1 + alpha*A)/a0;
  c[1] = (-2*cw)/a0;
  c[2] = (1 - alpha*A)/a0;
  c[3] = (-2*cw)/a0;
  c[4] = (1 - alpha/A)/a0;
);

function calc_lowpass(freq,q,c)
local(w,alpha,cw,a0)
(
  w=2*pi*min(freq,srate*0.45)/srate;
  alpha=sin(w)/(2*max(q,0.05));
  cw=cos(w); a0=1+alpha;
  c[0]=((1-cw)/2)/a0;
  c[1]=(1-cw)/a0;
  c[2]=((1-cw)/2)/a0;
  c[3]=(-2*cw)/a0;
  c[4]=(1-alpha)/a0;
);

function calc_highpass(freq,q,c)
local(w,alpha,cw,a0)
(
  w=2*pi*min(freq,srate*0.45)/srate;
  alpha=sin(w)/(2*max(q,0.05));
  cw=cos(w); a0=1+alpha;
  c[0]=((1+cw)/2)/a0;
  c[1]=(-(1+cw))/a0;
  c[2]=((1+cw)/2)/a0;
  c[3]=(-2*cw)/a0;
  c[4]=(1-alpha)/a0;
);

function calc_lowshelf(freq,gain_db,slope,c)
local(A,w,cw,sw,alpha,beta,a0)
(
  A=10^(gain_db/40);
  w=2*pi*min(freq,srate*0.45)/srate;
  cw=cos(w); sw=sin(w);
  slope=max(0.1,min(slope,2));
  alpha=sw/2*sqrt(max((A+1/A)*(1/slope-1)+2,0));
  beta=2*sqrt(A)*alpha;
  a0=(A+1)+(A-1)*cw+beta;
  c[0]=A*((A+1)-(A-1)*cw+beta)/a0;
  c[1]=2*A*((A-1)-(A+1)*cw)/a0;
  c[2]=A*((A+1)-(A-1)*cw-beta)/a0;
  c[3]=-2*((A-1)+(A+1)*cw)/a0;
  c[4]=((A+1)+(A-1)*cw-beta)/a0;
);

function calc_highshelf(freq,gain_db,slope,c)
local(A,w,cw,sw,alpha,beta,a0)
(
  A=10^(gain_db/40);
  w=2*pi*min(freq,srate*0.45)/srate;
  cw=cos(w); sw=sin(w);
  slope=max(0.1,min(slope,2));
  alpha=sw/2*sqrt(max((A+1/A)*(1/slope-1)+2,0));
  beta=2*sqrt(A)*alpha;
  a0=(A+1)-(A-1)*cw+beta;
  c[0]=A*((A+1)+(A-1)*cw+beta)/a0;
  c[1]=-2*A*((A-1)+(A+1)*cw)/a0;
  c[2]=A*((A+1)+(A-1)*cw-beta)/a0;
  c[3]=2*((A-1)-(A+1)*cw)/a0;
  c[4]=((A+1)-(A-1)*cw-beta)/a0;
);

function bq(x, c, st)
local(y)
(
  y = c[0]*x + st[0];
  st[0] = c[1]*x - c[3]*y + st[1];
  st[1] = c[2]*x - c[4]*y;
  y;
);

@slider
trim_lin = db2lin(slider1);
phase_mul = slider2 ? -1 : 1;

// M32-style dedicated LOW CUT: 4th-order Butterworth (24 dB/oct), implemented
// as two cascaded 2nd-order high-pass sections with the Butterworth Q values.
calc_highpass(slider4,0.5411961001,40);
calc_highpass(slider4,1.3065629649,50);

key_rc = 1/(2*pi*max(slider36,20));
dt = 1/srate;
key_hpf_a = key_rc/(key_rc+dt);

gate_thresh_lin = db2lin(slider6);
gate_floor = db2lin(-slider7);
gate_att = exp(-1/(max(slider8,0.1)*0.001*srate));
gate_rel = exp(-1/(max(slider10,1)*0.001*srate));
gate_hold_samples = slider9*0.001*srate;

// Low band: LCUT / LSHV / PEQ
slider30 < 0.5 ? calc_highpass(slider12,0.707,0) :
slider30 < 1.5 ? calc_lowshelf(slider12,slider13,max(0.2,min(slider14,2)),0) :
                  calc_peak(slider12,slider14,slider13,0);
// Mid bands: VEQ is intentionally a broad, musical bell approximation.
slider31 < 0.5 ? calc_peak(slider15,max(0.45,slider17*0.55),slider16,10) : calc_peak(slider15,slider17,slider16,10);
slider32 < 0.5 ? calc_peak(slider18,max(0.45,slider20*0.55),slider19,20) : calc_peak(slider18,slider20,slider19,20);
// High band: PEQ / HSHV / HCUT
slider33 < 0.5 ? calc_peak(slider21,slider23,slider22,30) :
slider33 < 1.5 ? calc_highshelf(slider21,slider22,max(0.2,min(slider23,2)),30) :
                  calc_lowpass(slider21,0.707,30);

// Two extra fully parametric output bands used only when EQ Topology = 6 Band.
slider44 < 0.5 ? calc_peak(slider38,max(0.45,slider40*0.55),slider39,60) : calc_peak(slider38,slider40,slider39,60);
slider45 < 0.5 ? calc_peak(slider41,max(0.45,slider43*0.55),slider42,70) : calc_peak(slider41,slider43,slider42,70);

comp_att = exp(-1/(max(slider27,0.1)*0.001*srate));
comp_rel = exp(-1/(max(slider28,1)*0.001*srate));
comp_knee_db = slider34*3;
activity_rel = exp(-1/(0.12*srate)); // ~120 ms visual decay for strip indicators

@block
// Publish the previous audio block's activity once per block to avoid host churn.
slider47=comp_meter;
slider48=gate_meter;
sliderchange(slider47);
sliderchange(slider48);

@sample
l = spl0 * trim_lin * phase_mul;
r = spl1 * trim_lin * phase_mul;

slider3 ? (
  l = bq(l,40,140);  r = bq(r,40,142);
  l = bq(l,50,150);  r = bq(r,50,152);
);

slider5 ? (
  gdet = max(abs(l),abs(r));
  gdet > gate_env ? gate_env = gate_att*gate_env + (1-gate_att)*gdet
                  : gate_env = gate_rel*gate_env + (1-gate_rel)*gdet;

  gate_env >= gate_thresh_lin ? (
    gate_hold_count = gate_hold_samples;
    gate_target = 1;
  ) : (
    gate_hold_count > 0 ? (
      gate_hold_count -= 1;
      gate_target = 1;
    ) : gate_target = gate_floor;
  );

  gate_target > gate_gain ? gate_gain = gate_att*gate_gain + (1-gate_att)*gate_target
                          : gate_gain = gate_rel*gate_gain + (1-gate_rel)*gate_target;
  l *= gate_gain;
  r *= gate_gain;
) : gate_gain = 1;

// Gate activity meter: logical closed state, not simply Gate enabled.
gate_closed_inst = (slider5 && gate_env < gate_thresh_lin && gate_hold_count <= 0) ? 1 : 0;
gate_closed_inst > gate_meter ? gate_meter=gate_closed_inst : gate_meter=activity_rel*gate_meter;

// Dedicated bus-tap outputs. PRE EQ is after LOW CUT / Gate but before channel EQ.
tap_preeq_l = l;
tap_preeq_r = r;

slider11 ? (
  l = bq(l, 0, 100);   r = bq(r, 0, 102);
  l = bq(l,10, 110);   r = bq(r,10, 112);
  slider46 >= 0.5 ? (
    l = bq(l,60, 160);  r = bq(r,60, 162);
    l = bq(l,70, 170);  r = bq(r,70, 172);
  );
  l = bq(l,20, 120);   r = bq(r,20, 122);
  l = bq(l,30, 130);   r = bq(r,30, 132);
);

// POST EQ tap is after all EQ bands but before Dynamics.
tap_posteq_l = l;
tap_posteq_r = r;

slider24 ? (
  key_l = slider37 ? spl2 : l;
  key_r = slider37 ? spl3 : r;
  slider35 ? (
    kyl = key_hpf_a*(key_hpf_yl + key_l - key_hpf_xl);
    kyr = key_hpf_a*(key_hpf_yr + key_r - key_hpf_xr);
    key_hpf_xl=key_l; key_hpf_xr=key_r;
    key_hpf_yl=kyl; key_hpf_yr=kyr;
    key_l=kyl; key_r=kyr;
  );

  cdet = max(abs(key_l),abs(key_r));
  cdet > comp_env ? comp_env = comp_att*comp_env + (1-comp_att)*cdet
                  : comp_env = comp_rel*comp_env + (1-comp_rel)*cdet;
  env_db = lin2db(comp_env);
  x_db = env_db-slider25;
  ratio=max(slider26,1);
  knee=comp_knee_db;
  knee <= 0 ? (
    x_db > 0 ? red_db = x_db*(1/ratio-1) : red_db=0;
  ) : (
    x_db <= -knee/2 ? red_db=0 :
    x_db >=  knee/2 ? red_db=x_db*(1/ratio-1) :
      red_db=(1/ratio-1)*(x_db+knee/2)^2/(2*knee);
  );
  comp_target = db2lin(red_db + slider29);
  comp_target < comp_gain ? comp_gain = comp_att*comp_gain + (1-comp_att)*comp_target
                          : comp_gain = comp_rel*comp_gain + (1-comp_rel)*comp_target;
  l *= comp_gain;
  r *= comp_gain;
) : (
  comp_gain = db2lin(slider29);
  red_db = 0;
);

// Compressor activity meter: actual gain reduction before makeup gain.
comp_gr_db = slider24 ? max(0,-red_db) : 0;
comp_gr_db > comp_meter ? comp_meter=comp_gr_db : comp_meter=activity_rel*comp_meter;

// Main processed path plus dedicated tap pairs used by M32-style mix-bus modes.
spl0 = l;
spl1 = r;
spl4 = tap_preeq_l;
spl5 = tap_preeq_r;
spl6 = tap_posteq_l;
spl7 = tap_posteq_r;
