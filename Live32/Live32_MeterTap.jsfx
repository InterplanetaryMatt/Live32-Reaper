desc:Live32 Meter Tap
// Pass-through post-FX/pre-fader peak tap used by the Live32 virtual PFL meter.
// Hidden parameters retain a short decay so GUI polling does not miss fast transients.
options:no_meter

in_pin:Main L
in_pin:Main R
in_pin:Key L
in_pin:Key R
in_pin:Pre EQ L
in_pin:Pre EQ R
in_pin:Post EQ L
in_pin:Post EQ R
out_pin:Main L
out_pin:Main R
out_pin:Key L
out_pin:Key R
out_pin:Pre EQ L
out_pin:Pre EQ R
out_pin:Post EQ L
out_pin:Post EQ R
slider1:0<0,4,0.0001>-PFL Meter L
slider2:0<0,4,0.0001>-PFL Meter R

@init
meter_l = 0;
meter_r = 0;

@block
// Roughly 20 dB/second release: fast enough to feel like an LED meter,
// slow enough for the Lua console to catch transient peaks reliably.
decay = exp(-2.302585093 * samplesblock / srate);
slider1 = max(meter_l, slider1 * decay);
slider2 = max(meter_r, slider2 * decay);
sliderchange(slider1);
sliderchange(slider2);
meter_l = 0;
meter_r = 0;

@sample
meter_l = max(meter_l,abs(spl0));
meter_r = max(meter_r,abs(spl1));
